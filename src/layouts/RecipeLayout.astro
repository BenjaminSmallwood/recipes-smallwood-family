---
import BaseLayout from "./BaseLayout.astro";
import TopBar from "../components/TopBar.astro";
import Sidebar from "../components/Sidebar.astro";
import ShoppingList from "../components/ShoppingList.astro";
import { getCollection } from "astro:content";

interface Props {
  title?: string;
}

const { title } = Astro.props;

const recipes = await getCollection("recipes");
const sortedRecipes = recipes.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title={title}>
  <TopBar />
  <Sidebar recipes={sortedRecipes} />

  <main class="pt-[57px] md:ml-[300px] print:m-0 print:p-0 lg:[.shopping-open_&]:mr-[320px]">
    <div class="p-6 md:p-8 print:p-0">
      <slot />
    </div>

    <footer class="print:hidden border-t border-border px-6 py-6 text-center text-sm text-gray-500 dark:border-border-dark dark:text-gray-400">
      Made with ❤️ by <a href="https://benjaminsmallwood.com" target="_blank" rel="noopener" class="font-medium text-primary hover:underline">Ben</a>
    </footer>
  </main>

  <ShoppingList />
</BaseLayout>
