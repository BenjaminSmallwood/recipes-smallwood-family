---
import RecipeCard from "./RecipeCard.astro";
import { formatQuantity, parseSteps } from "../lib/recipe";
import type { RecipeIngredient } from "../lib/ingredients";

interface Props {
  slug: string;
  title: string;
  image?: string;
  cookTime?: string;
  prepTime?: string;
  servings: number;
  ingredients: RecipeIngredient[];
  body: string;
  description?: string | null;
  sourceName?: string | null;
  sourceUrl?: string | null;
}

const { slug, title, image, cookTime, prepTime, servings, ingredients, body, description, sourceName, sourceUrl } = Astro.props;

// Blank lines in the description start new paragraphs
const descriptionParagraphs = description ? description.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];

const steps = parseSteps(body, ingredients, "font-semibold text-primary");

// What the shopping list needs from this recipe (read by shopping-list.js)
const shoppingData = JSON.stringify({
  slug,
  title,
  ingredients: ingredients.map(({ name, quantity, unit, aisle, onHand }) => ({ name, quantity, unit, aisle, onHand })),
}).replace(/</g, "\\u003c");
---

<article id="recipe-view" class="max-w-3xl mx-auto" data-base-servings={servings}>
  <div class="mb-4 flex flex-col-reverse gap-3 md:flex-row md:items-start md:justify-between md:gap-4 print:hidden">
    <h1 class="text-3xl font-bold">{title}</h1>
    <div class="flex shrink-0 flex-wrap justify-end gap-2 self-end md:self-auto">
    <button
      id="shopping-add-button"
      class="flex items-center gap-1.5 rounded-lg border border-border bg-primary px-3 py-1.5 text-sm font-medium text-black hover:bg-primary-light dark:border-border-dark"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <span id="shopping-add-label">Add to list</span>
    </button>
    <button
      id="print-card-button"
      class="flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-sm font-medium hover:bg-gray-100 dark:border-border-dark dark:hover:bg-gray-800"
      aria-label="Print recipe card"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
      </svg>
      Print
    </button>
    </div>
  </div>

  <script id="recipe-shopping-data" type="application/json" is:inline set:html={shoppingData} />

  {image && (
    <div class="mb-6 overflow-hidden rounded-xl print:hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-64 object-cover bg-gray-100 dark:bg-gray-800"
        onerror="this.style.display='none'"
      />
    </div>
  )}

  {descriptionParagraphs.length > 0 && (
    <div class="mb-4 space-y-3 leading-relaxed text-gray-700 dark:text-gray-300 print:hidden">
      {descriptionParagraphs.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
    </div>
  )}

  {sourceName && (
    <p class="mb-4 text-sm text-gray-500 dark:text-gray-400 print:hidden">
      Recipe originally from{" "}
      {sourceUrl ? (
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:underline">{sourceName}</a>
      ) : (
        <span class="font-medium">{sourceName}</span>
      )}
    </p>
  )}

  <div class="flex flex-wrap gap-4 mb-6 text-sm print:hidden">
    {prepTime && (
      <div class="flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 dark:border-border-dark">
        <svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Prep: {prepTime}</span>
      </div>
    )}
    {cookTime && (
      <div class="flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 dark:border-border-dark">
        <svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
        </svg>
        <span>Cook: {cookTime}</span>
      </div>
    )}
  </div>

  <!-- Multiplier -->
  <div class="mb-6 flex items-center gap-3 print:hidden rounded-lg border border-border px-4 py-3 dark:border-border-dark">
    <span class="text-sm font-medium">Multiply:</span>
    <div class="flex items-center gap-1">
      <button
        id="multiplier-decrease"
        class="rounded-md border border-border px-2 py-0.5 text-lg font-bold hover:bg-gray-100 dark:border-border-dark dark:hover:bg-gray-800"
        aria-label="Decrease multiplier"
      >−</button>
      <span id="multiplier-display" class="w-16 text-center text-sm font-semibold text-primary">×1</span>
      <button
        id="multiplier-increase"
        class="rounded-md border border-border px-2 py-0.5 text-lg font-bold hover:bg-gray-100 dark:border-border-dark dark:hover:bg-gray-800"
        aria-label="Increase multiplier"
      >+</button>
    </div>
    <span class="text-xs text-gray-500">Serves {servings} per batch</span>
  </div>

  <!-- Ingredients -->
  <div class="mb-8 print:hidden">
    <h2 class="text-xl font-bold mb-3">Ingredients</h2>
    <ul class="space-y-2">
      {ingredients.map((ing) => (
        <li
          class="ingredient-item flex items-baseline gap-2 rounded px-2 py-1 hover:bg-gray-50 dark:hover:bg-gray-800/50"
          data-base-qty={ing.quantity}
          data-unit={ing.unit}
          data-name={ing.name}
        >
          <span class="ingredient-qty font-semibold text-primary min-w-[4rem]">
            {formatQuantity(ing.quantity)}{ing.unit ? ` ${ing.unit}` : ""}
          </span>
          <span>{ing.name}{ing.prep && <span class="text-gray-500 dark:text-gray-400">, {ing.prep}</span>}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Instructions -->
  <div class="mb-8 print:hidden">
    <h2 class="text-xl font-bold mb-3">Instructions</h2>
    <ol class="instructions-body space-y-3 list-decimal list-inside">
      {steps.map((step) => <li class="leading-relaxed" set:html={step} />)}
    </ol>
  </div>

  <RecipeCard
    title={title}
    image={image}
    cookTime={cookTime}
    prepTime={prepTime}
    servings={servings}
    ingredients={ingredients}
    body={body}
    sourceName={sourceName}
    sourceUrl={sourceUrl}
  />
</article>
