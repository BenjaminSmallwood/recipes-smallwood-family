---
interface Recipe {
  id: string;
  data: {
    title: string;
    category: string;
    ingredients: { item: string }[];
  };
}

interface Props {
  recipes: Recipe[];
  currentSlug?: string;
}

const { recipes, currentSlug } = Astro.props;

const grouped = recipes.reduce(
  (acc, recipe) => {
    const cat = recipe.data.category;
    if (!acc[cat]) acc[cat] = [];
    acc[cat].push(recipe);
    return acc;
  },
  {} as Record<string, Recipe[]>
);

const categories = Object.keys(grouped).sort();
---

<nav
  id="sidebar"
  class="print:hidden fixed left-0 top-[57px] bottom-0 z-40 w-[300px] -translate-x-full overflow-y-auto border-r border-border bg-sidebar p-4 transition-transform md:translate-x-0 dark:border-border-dark dark:bg-sidebar-dark"
  transition:persist
>
  <!-- Stays put while the recipe list scrolls; -top-4 cancels the nav's p-4 -->
  <div class="sticky -top-4 z-10 -mx-4 -mt-4 mb-3 bg-sidebar px-4 pt-4 pb-1 dark:bg-sidebar-dark">
    <input
      id="recipe-search"
      type="search"
      placeholder="Search recipes or ingredients..."
      class="w-full rounded-lg border border-border bg-surface dark:bg-surface-dark px-3 py-1.5 text-sm outline-none focus:border-primary dark:border-border-dark dark:text-text-dark"
    />
  </div>
  <p id="search-empty" class="px-3 py-2 text-sm text-gray-500 dark:text-gray-400" hidden>No recipes match your search.</p>
  <div id="sidebar-recipes" class="space-y-2">
    {categories.map((category) => (
      <details class="recipe-category group" open>
        <summary class="flex cursor-pointer items-center justify-between rounded-lg px-3 py-2 font-semibold text-sm hover:bg-gray-100 dark:hover:bg-gray-800 select-none">
          <span>{category}</span>
          <svg class="h-4 w-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </summary>
        <ul class="mt-1 space-y-0.5 pl-2">
          {grouped[category].map((recipe) => (
            <li>
              <a
                href={`/recipes/${recipe.id}`}
                class:list={[
                  "recipe-link block rounded-lg px-3 py-1.5 text-sm transition-colors",
                  recipe.id === currentSlug
                    ? "bg-primary/10 text-primary font-medium"
                    : "hover:bg-gray-100 dark:hover:bg-gray-800",
                ]}
                data-title={recipe.data.title.toLowerCase()}
                data-category={recipe.data.category.toLowerCase()}
                data-ingredients={recipe.data.ingredients.map((ing) => ing.item).join("|")}
              >
                {recipe.data.title}
                <span class="recipe-match block text-xs font-normal text-gray-500 dark:text-gray-400" hidden></span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>
</nav>

<!-- Overlay for mobile -->
<div
  id="sidebar-overlay"
  class="print:hidden fixed inset-0 top-[57px] z-30 hidden bg-black/40 md:hidden"
></div>

<script is:inline>
  // Collapse categories on mobile
  if (window.innerWidth < 768) {
    document.querySelectorAll('.recipe-category').forEach(d => d.open = false);
  }
</script>
