---

---

<header
  class="print:hidden fixed top-0 left-0 right-0 z-50 flex items-center justify-between gap-4 border-b border-border bg-surface px-4 py-3 dark:border-border-dark dark:bg-surface-dark"
  transition:persist
>
  <div class="flex items-center gap-3">
    <button
      id="sidebar-toggle"
      class="md:hidden rounded-lg p-2 hover:bg-gray-100 dark:hover:bg-gray-800"
      aria-label="Toggle menu"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
    <a href="/" class="text-lg font-bold text-primary whitespace-nowrap">
      Smallwood Recipes
    </a>
  </div>

  <div class="hidden md:block flex-1 max-w-md mx-4">
    <input
      id="recipe-search"
      type="search"
      placeholder="Search recipes..."
      class="w-full rounded-lg border border-border bg-surface dark:bg-surface-dark px-3 py-1.5 text-sm outline-none focus:border-primary dark:border-border-dark dark:text-text-dark"
    />
  </div>

  <div class="flex items-center gap-2">
    <div
      id="theme-toggle"
      role="radiogroup"
      aria-label="Color theme"
      class="flex items-center rounded-lg border border-border p-0.5 dark:border-border-dark"
    >
      <button type="button" role="radio" data-theme-option="light" aria-label="Light theme" title="Light"
        class="theme-option rounded-md p-1.5 hover:bg-gray-100 dark:hover:bg-gray-800">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>
      <button type="button" role="radio" data-theme-option="dark" aria-label="Dark theme" title="Dark"
        class="theme-option rounded-md p-1.5 hover:bg-gray-100 dark:hover:bg-gray-800">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
      <button type="button" role="radio" data-theme-option="system" aria-label="System theme" title="System"
        class="theme-option rounded-md p-1.5 hover:bg-gray-100 dark:hover:bg-gray-800">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </button>
    </div>

    <button
      id="wake-lock-toggle"
      class="flex items-center gap-1.5 rounded-lg px-2 py-1.5 text-sm hover:bg-gray-100 dark:hover:bg-gray-800 whitespace-nowrap"
      aria-label="Keep screen on"
    >
      <svg id="wake-lock-icon" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
      </svg>
      <span id="wake-lock-label" class="hidden sm:inline text-xs">Keep Screen On</span>
    </button>
  </div>
</header>
